{
  "name": "quota-reroute",
  "description": "Primary Claude account hits a real rate_limit_event; DALANG automatically reroutes to backup account (custom CLAUDE_CONFIG_DIR) and completes + reviews the task.",
  "turns": [
    {
      "id": "primary-rate-limited",
      "match": {
        "provider": "claude-code",
        "promptContains": "T-001"
      },
      "stdoutLines": [
        "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"claude-primary-sess-1\",\"model\":\"claude-opus-5-5\"}",
        "{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"rejected\",\"rateLimitType\":\"five_hour\",\"utilization\":1.0}}",
        "{\"type\":\"result\",\"subtype\":\"error\",\"session_id\":\"claude-primary-sess-1\",\"is_error\":true,\"result\":\"Rate limit reached\"}"
      ],
      "stderrLines": [],
      "exitCode": 1
    },
    {
      "id": "backup-account-coder",
      "match": {
        "provider": "claude-code",
        "promptContains": "T-001"
      },
      "files": {
        "src/math.mjs": "export function add(a, b) { return a + b; }\n",
        "src/math.test.mjs": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { add } from './math.mjs';\ntest('add', () => assert.equal(add(2, 3), 5));\n",
        ".dalang/tasks/T-001/result.json": "{\"task_id\":\"T-001\",\"status\":\"completed\",\"changed_files\":[\"src/math.mjs\",\"src/math.test.mjs\"],\"summary\":\"Implemented add() and unit test\",\"notes\":[],\"blockers\":[],\"verify_command\":\"node --test src/math.test.mjs\",\"verify_exit_code\":0}"
      },
      "stdoutLines": [
        "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"claude-acct2-sess-1\",\"model\":\"claude-sonnet-5-5\"}",
        "{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5-5\",\"content\":[{\"type\":\"text\",\"text\":\"Implemented add() and verified tests.\"}]}}",
        "{\"type\":\"result\",\"subtype\":\"success\",\"session_id\":\"claude-acct2-sess-1\",\"result\":\"Done\",\"usage\":{\"input_tokens\":1200,\"output_tokens\":450,\"cache_read_input_tokens\":4800,\"cache_creation_input_tokens\":300},\"total_cost_usd\":0.0124}"
      ],
      "exitCode": 0
    },
    {
      "id": "codex-reviewer-pass",
      "match": {
        "provider": "codex",
        "promptContains": "code review round 1"
      },
      "stdoutLines": [
        "{\"type\":\"thread.started\",\"thread_id\":\"codex-rev-1\"}",
        "{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"{\\\"task_id\\\":\\\"T-001\\\",\\\"status\\\":\\\"pass\\\",\\\"verify_exit_code\\\":0,\\\"summary\\\":\\\"Clean add() implementation and passing test.\\\",\\\"findings\\\":[]}\"}}",
        "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":2500,\"cached_input_tokens\":1500,\"output_tokens\":180}}"
      ],
      "exitCode": 0
    }
  ]
}
