{
  "name": "@dalang/server",
  "version": "0.14.9",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/dev.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dalang/core": "workspace:*",
    "@dalang/shared": "workspace:*",
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "5.1.0"
  }
}
