{
  "name": "dalang-cli",
  "version": "0.14.6",
  "description": "DALANG: local orchestrator for Claude Code, Codex, and Antigravity CLI",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ai",
    "coding-agents",
    "claude-code",
    "codex",
    "antigravity",
    "orchestrator"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "dalang": "./bin/dalang.js"
  },
  "files": [
    "bin",
    "bundle",
    "web-dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rolldown -c rolldown.config.mjs && node ./scripts/prepare-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node ./bin/dalang.js",
    "doctor": "node ./bin/dalang.js doctor",
    "prepack": "node ./scripts/prepare-pack.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "better-sqlite3": "13.2.0",
    "chalk": "6.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ink": "8.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "react": "19.3.1",
    "simple-git": "4.1.0",
    "wrap-ansi": "10.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dalang/core": "workspace:*",
    "@dalang/server": "workspace:*",
    "@dalang/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "rolldown": "1.2.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azmifauzan/dalang.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/azmifauzan/dalang#readme",
  "bugs": {
    "url": "https://github.com/azmifauzan/dalang/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
