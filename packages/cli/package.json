{
  "name": "dalang",
  "version": "0.5.0",
  "description": "DALANG - Local orchestrator for Claude Code, Codex, and Antigravity CLI",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ai",
    "coding-agents",
    "claude-code",
    "codex",
    "antigravity",
    "orchestrator"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "dalang": "./bin/dalang.js"
  },
  "files": [
    "bin",
    "bundle",
    "web-dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rolldown -c rolldown.config.mjs && node ./scripts/prepare-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node ./bin/dalang.js",
    "doctor": "node ./bin/dalang.js doctor",
    "prepack": "node ./scripts/prepare-pack.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "simple-git": "4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@dalang/core": "workspace:*",
    "@dalang/server": "workspace:*",
    "rolldown": "1.2.19"
  }
}
